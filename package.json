{
  "name": "pmdc-batch4-datnt250",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống Quản trị & Phân tích Dấu chân Carbon cho Gia đình/Văn phòng nhỏ (Personal & Micro-Office Carbon Ledger)",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "build": "npm --prefix src/frontend run build",
    "preview": "npm --prefix src/frontend run preview",
    "backend:dev": "cd src/backend && ./mvnw spring-boot:run",
    "backend:build": "cd src/backend && ./mvnw clean package",
    "backend:test": "cd src/backend && ./mvnw test",
    "db:up": "./database/init.sh docker",
    "db:down": "docker-compose -f database/docker-compose.yml down",
    "db:reset": "./database/init.sh reset",
    "db:verify": "./database/init.sh verify"
  }
}
